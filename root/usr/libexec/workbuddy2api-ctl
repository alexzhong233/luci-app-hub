#!/bin/sh
# WorkBuddy2API 在 OpenWrt 上的四种安装方式，四选一（两种来源 × 本地/容器）。
#
#   python            本地·原版    niyouqianma 的 apk/ipk（Python，带 python3 依赖）
#   python-docker     容器·原版    ghcr.io/niyouqianma/workbuddy2api-hub
#   python-ce         本地·社区版  M-strange/workbuddy2api-hub 的 apk/ipk
#   python-docker-ce  容器·社区版  ghcr.io/m-strange/workbuddy2api-hub
#
# 两个上游装出来的是同一套程序（同一个 init.d、同一个 /etc/config/workbuddy2api、
# 同一个数据目录），差别只在来源与版本：
#   原版     niyouqianma/workbuddy2api-hub  —— 一直在出 release（当前 v2.1.3）
#   社区版   M-strange/workbuddy2api-hub    —— 社区接管分支，合并 PR #813-#819（当前 v2.2.0）
# 更早的两个上游 ardeyouxipianyi/workbuddy2api-hub 与 Rust 重写分支
# YTjungle666/workbuddy2api-hub 都已删库，Rust 两套不再提供安装（只能识别 + 卸载）。
#
# 四种装法共用同一个数据目录：$DATADIR/accounts（每账号一个 JSON）与
# $DATADIR/usage（用量日志）。切换实现只换运行方式，账号和额度记录都不动。
# 端口 8788、目录同一份，同一时刻只能跑一个（本地与容器互斥，两种来源也互斥）。
# 装在哪种来源会记在 $DATADIR/.wb2api-<python|python-docker>.source 里，
# 页面靠它决定哪个页签标「已装」。

REPO_OFFICIAL="niyouqianma/workbuddy2api-hub"
REPO_COMMUNITY="M-strange/workbuddy2api-hub"
IMG_OFFICIAL="ghcr.io/niyouqianma/workbuddy2api-hub"
IMG_COMMUNITY="ghcr.io/m-strange/workbuddy2api-hub"

CT_NAME="wb-proxy"
TASK_DIR="/var/run/workbuddy2api-task"
RUST_BIN="/usr/bin/wb-backend"
PY_INIT="/etc/init.d/workbuddy2api"
RS_INIT="/etc/init.d/workbuddy2api-rust"
DIR_DEFAULT="/mnt/sda1/Configs/workbuddy2api"
PORT_DEFAULT="8788"

VARIANT=""
DATADIR=$(uci -q get workbuddy2api.main.datadir)
[ -n "$DATADIR" ] || DATADIR="$DIR_DEFAULT"
PORT=$(uci -q get workbuddy2api.main.port)
[ -n "$PORT" ] || PORT="$PORT_DEFAULT"

ACCOUNTS_DIR="$DATADIR/accounts"
USAGE_DIR="$DATADIR/usage"
COMPOSE_FILE="$DATADIR/docker-compose.yml"

# ---------------------------------------------------------------- 变体映射
# 四个 install id → 物理实现（本地 python / 容器）与来源（official / community）
kind_of() {
	case "$1" in
		python | python-ce) echo "python" ;;
		python-docker | python-docker-ce) echo "python-docker" ;;
		*) echo "" ;;
	esac
}

src_of() {
	case "$1" in
		*-ce) echo "community" ;;
		*) echo "official" ;;
	esac
}

repo_of() {
	case "$1" in
		community) echo "$REPO_COMMUNITY" ;;
		*) echo "$REPO_OFFICIAL" ;;
	esac
}

img_of() {
	case "$1" in
		community) echo "$IMG_COMMUNITY" ;;
		*) echo "$IMG_OFFICIAL" ;;
	esac
}

# ---------------------------------------------------------------- 基础工具
arch_name() {
	case "$(uname -m)" in
		aarch64 | arm64) echo "aarch64" ;;
		x86_64 | amd64) echo "x86_64" ;;
		*) echo "" ;;
	esac
}

# lan ipaddr 常带掩码（192.168.88.1/24），直接拼 URL 会变成 /24:8788。
lan_ip() {
	local ip

	ip=$(uci -q get network.lan.ipaddr)
	ip=${ip%%/*}
	[ -n "$ip" ] || ip=$(ip -4 addr show br-lan 2>/dev/null |
		awk '/inet /{sub(/\/.*/, "", $2); print $2; exit}')
	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr)
	echo "${ip:-192.168.1.1}"
}

host_ip() {
	# --lan 会把网关暴露到局域网，地址就按 LAN 来
	lan_ip
}

task_phase() {
	[ -s "$TASK_DIR/state" ] && cat "$TASK_DIR/state" 2>/dev/null || echo "idle"
}

set_phase() {
	mkdir -p "$TASK_DIR"
	echo "$1" >"$TASK_DIR/state"
}

vnum() {
	echo "${1#v}"
}

have_docker() {
	command -v docker >/dev/null 2>&1
}

# status 一次执行里会连问好几遍，缓存成一次 docker info。
DOCKER_LIVE=""
docker_live() {
	[ "$DOCKER_LIVE" = 1 ] && return 0
	[ "$DOCKER_LIVE" = 0 ] && return 1

	have_docker && docker info >/dev/null 2>&1 || {
		DOCKER_LIVE=0
		return 1
	}

	DOCKER_LIVE=1
	return 0
}

pkg_mgr() {
	command -v apk >/dev/null 2>&1 && {
		echo "apk"
		return 0
	}
	command -v opkg >/dev/null 2>&1 && {
		echo "opkg"
		return 0
	}
	echo ""
}

# ---------------------------------------------------------------- 上游版本
# 走 releases/latest 的 HTTP 重定向，不碰 GitHub API，不受未认证 60 次/小时限制。
gh_latest_release() {
	local loc

	loc=$(curl -sI --max-time 15 "https://github.com/$1/releases/latest" 2>/dev/null |
		tr -d '\r' | sed -n 's#^[Ll]ocation:.*/tag/\(.*\)$#\1#p' | tail -n1)

	case "$loc" in
		v[0-9]*) echo "$loc" ;;
		*) echo "" ;;
	esac
}

cached_latest() {
	[ -s "$TASK_DIR/latest-$1" ] && cat "$TASK_DIR/latest-$1" 2>/dev/null
}

# ---------------------------------------------------------------- 安装状态
py_present() {
	[ -x "$PY_INIT" ]
}

py_running() {
	local p exe

	for p in /proc/[0-9]*; do
		[ -r "$p/cmdline" ] || continue
		exe=$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null)
		case "$exe" in
			*wb_proxy*) echo 1; return 0 ;;
		esac
	done
	return 1
}

rs_present() {
	[ -x "$RUST_BIN" ]
}

rs_running() {
	local p exe

	for p in /proc/[0-9]*; do
		[ -r "$p/cmdline" ] || continue
		exe=$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null)
		case "$exe" in
			*wb-backend*) echo 1; return 0 ;;
		esac
	done
	return 1
}

ct_state() {
	docker_live || return 1
	docker inspect --format '{{.State.Status}}' "$CT_NAME" 2>/dev/null
}

ct_image() {
	docker_live || return 1
	docker inspect --format '{{.Config.Image}}' "$CT_NAME" 2>/dev/null
}

# 容器版：两种来源都算「已装」
pd_present() {
	case "$(ct_image)" in
		*niyouqianma/workbuddy2api-hub* | *m-strange/workbuddy2api-hub*) return 0 ;;
	esac
	return 1
}

# 容器镜像属于哪个来源（认不出就空）
pd_src() {
	case "$(ct_image)" in
		*m-strange/workbuddy2api-hub*) echo "community" ;;
		*niyouqianma/workbuddy2api-hub*) echo "official" ;;
	esac
}

# 遗留：Rust 版镜像（上游仓库已删除，只用于识别和清理）
rd_present() {
	case "$(ct_image)" in
		*ytjungle666/workbuddy2api-hub*) return 0 ;;
	esac
	return 1
}

ct_running() {
	[ "$(ct_state)" = "running" ]
}

port_listening() {
	netstat -lnt 2>/dev/null | grep -q ":$1 "
}

# 装在哪种来源也记在数据目录里：同一个 init.d、同一个版本号，只能靠这个区分
# 「原版」和「社区版」。老机器上没有这个文件时按 official 处理。
src_file() {
	echo "$DATADIR/.wb2api-$1.source"
}

read_src() {
	local v

	v=$(cat "$(src_file "$1")" 2>/dev/null)
	[ -n "$v" ] || v="official"
	echo "$v"
}

write_src() {
	mkdir -p "$DATADIR" 2>/dev/null
	echo "$2" >"$(src_file "$1")"
}

# 装完把版本记在数据目录里，跟着数据走：换实现、换目录都不会读错。
ver_file() {
	echo "$DATADIR/.wb2api-$1.version"
}

read_ver() {
	[ -s "$(ver_file "$1")" ] && cat "$(ver_file "$1")" 2>/dev/null
}

write_ver() {
	mkdir -p "$DATADIR" 2>/dev/null
	echo "$2" >"$(ver_file "$1")"
}

ver_python() {
	local v

	py_present || return 0

	v=$(read_ver python)
	[ -n "$v" ] && {
		echo "$v"
		return 0
	}

	case "$(pkg_mgr)" in
		apk)
			apk list -I 2>/dev/null | sed -n 's/^workbuddy2api-\([0-9][^-]*\)-.*/\1/p' | head -n1
			;;
		opkg)
			opkg list-installed 2>/dev/null | awk '$1=="workbuddy2api"{print $3}' | sed 's/-[0-9]*$//' | head -n1
			;;
	esac
}

ver_rust() {
	local v

	v=$(read_ver rust)
	[ -n "$v" ] && {
		echo "$v"
		return 0
	}
	[ -x "$RUST_BIN" ] || return 0
	"$RUST_BIN" --version 2>/dev/null |
		sed -n 's/.*[^0-9]\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9.]*\).*/\1/p' | head -n1
}

# 容器版本从镜像标签取：jar 里最靠得住的就这个。
ver_ct() {
	local img

	img=$(ct_image)
	[ -n "$img" ] || return 0
	img=${img##*:}
	[ "$img" = "latest" ] && return 0
	echo "$(vnum "$img")"
}

# ---------------------------------------------------------------- 磁盘
cmd_disks() {
	df -k 2>/dev/null | awk 'NR>1 && $6 ~ /^\/mnt\// {print "disk=" $6 ":" $4}'
	# /opt 多数机器上就在 overlay 里，df 不把它当挂载点单列，但一样能放数据
	if [ -d /opt ] && [ -w /opt ]; then
		echo "disk=/opt:$(df -k /opt 2>/dev/null | awk 'NR==2 {print $4}')"
	fi
	return 0
}

disk_info() {
	local d_free o_free k_free root

	d_free=$(df -k "$DIR_DEFAULT" 2>/dev/null | awk 'NR==2 {print $4}')
	[ -n "$d_free" ] || d_free=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')
	o_free=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')

	k_free=""
	if docker_live; then
		root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)
		[ -n "$root" ] && k_free=$(df -k "$root" 2>/dev/null | awk 'NR==2 {print $4}')
	fi

	echo "data_free_kb=${d_free:-0}"
	echo "overlay_free_kb=${o_free:-0}"
	echo "docker_free_kb=${k_free:-0}"
}

# ---------------------------------------------------------------- 配置写入
save_cfg() {
	# $1=variant $2=port $3=datadir
	uci -q get workbuddy2api.main >/dev/null 2>&1 || uci -q set workbuddy2api.main=workbuddy2api
	uci -q set "workbuddy2api.main.variant=$1"
	uci -q set "workbuddy2api.main.port=$2"
	uci -q set "workbuddy2api.main.datadir=$3"
	uci -q set "workbuddy2api.main.host=0.0.0.0"
	# 这两个是上游 init.d 直接读的字段，指向同一个数据目录，四版共用。
	uci -q set "workbuddy2api.main.accounts_dir=$3/accounts"
	uci -q set "workbuddy2api.main.usage_dir=$3/usage"
	# 老机器上这两个字段可能是别的值，统一成能跑面板的档位
	uci -q set "workbuddy2api.main.stats_ttl=900"
	uci -q set "workbuddy2api.main.warm=1"
	uci -q commit workbuddy2api
}

# ---------------------------------------------------------------- 状态
cmd_status() {
	local kind="" ctimg cts
	local py_p pd_p rs_p rd_p
	local py_r pd_r rs_r rd_r

	py_p=0; py_present && py_p=1
	pd_p=0; pd_present && pd_p=1
	rs_p=0; rs_present && rs_p=1
	rd_p=0; rd_present && rd_p=1

	py_r=0; py_running >/dev/null && py_r=1
	rs_r=0; rs_running >/dev/null && rs_r=1
	pd_r=0; rd_r=0
	cts=$(ct_state)
	if [ "$cts" = "running" ]; then
		[ "$pd_p" = "1" ] && pd_r=1
		[ "$rd_p" = "1" ] && rd_r=1
	fi

	# 谁在跑就是谁；都没跑就按「装了谁」判断（互斥，理论上最多一个）
	if [ "$py_r" = "1" ]; then
		kind="python"
	elif [ "$pd_r" = "1" ]; then
		kind="python-docker"
	elif [ "$rs_r" = "1" ]; then
		kind="rust"
	elif [ "$rd_r" = "1" ]; then
		kind="rust-docker"
	elif [ "$py_p" = "1" ]; then
		kind="python"
	elif [ "$pd_p" = "1" ]; then
		kind="python-docker"
	elif [ "$rs_p" = "1" ]; then
		kind="rust"
	elif [ "$rd_p" = "1" ]; then
		kind="rust-docker"
	else
		kind="none"
	fi

	echo "kind=$kind"
	echo "variant=$kind"
	echo "port=$PORT"
	echo "datadir=$DATADIR"
	echo "latest_official=$(cached_latest official)"
	echo "latest_community=$(cached_latest community)"
	echo "task=$(task_phase)"
	echo "arch=$(arch_name)"
	echo "docker=$(docker_live && echo 1 || echo 0)"
	echo "pkgmgr=$(pkg_mgr)"
	echo "pkgpython=$(command -v python3 >/dev/null 2>&1 && echo 1 || echo 0)"
	echo "accounts=$(ls -1 "$ACCOUNTS_DIR"/*.json 2>/dev/null | wc -l)"
	echo "usagesize_kb=$(du -sk "$USAGE_DIR" 2>/dev/null | awk '{print $1}')"

	disk_info

	echo "python_present=$py_p"
	echo "python_running=$py_r"
	echo "python_version=$(ver_python)"
	echo "python_source=$([ "$py_p" = "1" ] && read_src python)"

	echo "python_docker_present=$pd_p"
	echo "python_docker_running=$pd_r"
	echo "python_docker_version=$([ "$pd_p" = "1" ] && ver_ct)"
	echo "python_docker_source=$([ "$pd_p" = "1" ] && { pd_src | grep . || read_src python-docker; })"

	echo "rust_present=$rs_p"
	echo "rust_running=$rs_r"
	echo "rust_version=$(ver_rust)"

	echo "rust_docker_present=$rd_p"
	echo "rust_docker_running=$rd_r"
	echo "rust_docker_version=$([ "$rd_p" = "1" ] && ver_ct)"

	# 遗留的 Rust 版：上游删库后不再提供安装，但已经装上的仍要能看见、能清掉
	echo "legacy=$([ "$rs_p" = "1" ] || [ "$rd_p" = "1" ] && echo 1 || echo 0)"

	# 当前这一套的来源：页面用它决定哪个页签标「已装」
	echo "source=$(case "$kind" in
		python) read_src python ;;
		python-docker) pd_src | grep . || read_src python-docker ;;
		rust | rust-docker) echo "" ;;
	esac)"

	# 当前这一套的合并视图，页面直接用
	case "$kind" in
		none)
			echo "installed=0"
			echo "running=0"
			echo "address=http://$(host_ip):$PORT"
			echo "version="
			;;
		*)
			echo "installed=1"
			echo "address=http://$(host_ip):$PORT"
			echo "version=$(case "$kind" in
				python) ver_python ;;
				python-docker) ver_ct ;;
				rust) ver_rust ;;
				rust-docker) ver_ct ;;
			esac)"
			case "$kind" in
				python) echo "running=$py_r" ;;
				python-docker | rust-docker) echo "running=$([ "$cts" = "running" ] && echo 1 || echo 0)" ;;
				rust) echo "running=$rs_r" ;;
			esac
			;;
	esac

	echo "listening=$(port_listening "$PORT" && echo 1 || echo 0)"
	return 0
}

cmd_latest() {
	local which="$1" src p

	mkdir -p "$TASK_DIR"

	case "$which" in
		'' | all | official | community) ;;
		python) which=official ;;
		*) return 0 ;;
	esac

	for src in official community; do
		[ -z "$which" ] || [ "$which" = "all" ] || [ "$which" = "$src" ] || continue

		p=$(gh_latest_release "$(repo_of "$src")")
		if [ -n "$p" ]; then
			echo "$p" >"$TASK_DIR/latest-$src"
		else
			p=$(cached_latest "$src")
		fi
		echo "$src=$p"
	done

	return 0
}

# ---------------------------------------------------------------- 后台任务
SELF=$(readlink -f "$0" 2>/dev/null)
[ -n "$SELF" ] || SELF="$0"

spawn_task() {
	local phase="$1"
	local label="$2"
	local log="$TASK_DIR/log"

	shift 2

	mkdir -p "$TASK_DIR"
	: >"$log"
	set_phase "$phase"

	if command -v setsid >/dev/null 2>&1; then
		setsid "$SELF" "$@" </dev/null >>"$log" 2>&1 &
	else
		("$SELF" "$@" </dev/null >>"$log" 2>&1 &)
	fi

	echo "已开始：$label"
	echo "后台执行中，完成后刷新本页；日志：$log"
	return 0
}

# ---------------------------------------------------------------- 互斥检查
# 返回 0 = 可以装；否则打印原因并返回 4
check_exclusive() {
	local want kind

	want="$1"
	kind=$(kind_of "$want")
	[ -n "$kind" ] || kind="$want"

	if [ "$kind" != "python" ] && py_present; then
		echo "已装「本地」版（原版或社区版），四选一，请先卸载它。" >&2
		return 4
	fi
	if [ "$kind" != "python-docker" ] && pd_present; then
		echo "已装「容器」版（原版或社区版），四选一，请先卸载它。" >&2
		return 4
	fi
	# 遗留的 Rust 版也占着同一个端口和数据目录，装新的之前必须先清掉
	if rs_present; then
		echo "还留着旧的「本地·Rust」，上游仓库已删除、不再提供安装，请先卸载它。" >&2
		return 4
	fi
	if rd_present; then
		echo "还留着旧的「容器·Rust」，上游仓库已删除、不再提供安装，请先卸载它。" >&2
		return 4
	fi

	return 0
}

# ---------------------------------------------------------------- 本地·Python
worker_python() {
	local tag="$1" port="$2" dir="$3" src="${4:-official}" ver url tmp f mgr i=0

	# 版本号与来源都记在「这次装的目录」里，不是 uci 里可能过期的那个
	DATADIR="$dir"

	mgr=$(pkg_mgr)
	[ -n "$mgr" ] || {
		set_phase "error:没有 apk 也没有 opkg，认不出包管理器"
		return 1
	}

	[ -n "$tag" ] || {
		set_phase "error:取不到上游版本号（网络不通？）"
		return 1
	}
	ver=$(vnum "$tag")

	tmp="$dir/.setup"
	rm -rf "$tmp"
	mkdir -p "$tmp" || {
		set_phase "error:无法创建临时目录 $tmp"
		return 1
	}

	case "$mgr" in
		apk)
			f="$tmp/workbuddy2api-$ver-r1.apk"
			url="https://github.com/$(repo_of "$src")/releases/download/$tag/workbuddy2api-$ver-r1.apk"
			;;
		opkg)
			f="$tmp/workbuddy2api_${ver}-1_all.ipk"
			url="https://github.com/$(repo_of "$src")/releases/download/$tag/workbuddy2api_${ver}-1_all.ipk"
			;;
	esac

	echo "== 下载 $url"
	set_phase "downloading:$tag"
	if ! curl -fL --retry 2 --connect-timeout 15 -o "$f" "$url"; then
		echo "== 下载失败，试 release 页面里的资产名"
		set_phase "error:下载失败（$url）"
		rm -rf "$tmp"
		return 1
	fi

	echo "== 安装（$mgr）"
	set_phase "installing:$tag"
	case "$mgr" in
		apk)
			# 先删再装：重装/升级时留着旧包会撞文件冲突，而且 apk 不会
			# 自动把旧版本的文件清干净。/etc/config 是 conffile，删包不会丢。
			apk del workbuddy2api >/dev/null 2>&1
			apk add --allow-untrusted "$f" 2>&1 || {
				echo "== apk add 失败：看上面是不是缺依赖或源不通"
				set_phase "error:apk add 失败，见上方输出"
				rm -rf "$tmp"
				return 1
			}
			;;
		opkg)
			opkg remove workbuddy2api >/dev/null 2>&1
			opkg install "$f" 2>&1 || {
				set_phase "error:opkg install 失败，见上方输出"
				rm -rf "$tmp"
				return 1
			}
			;;
	esac

	rm -rf "$tmp"

	echo "== 写配置：端口 $port，数据目录 $dir"
	save_cfg python "$port" "$dir"
	write_ver python "$ver"
	write_src python "$src"

	[ -x "$PY_INIT" ] || {
		set_phase "error:装完了但没有 $PY_INIT，包结构不对"
		return 1
	}

	"$PY_INIT" enable >/dev/null 2>&1
	"$PY_INIT" restart >/dev/null 2>&1

	echo "== 等面板起来"
	set_phase "starting:$tag"
	while [ $i -lt 40 ]; do
		port_listening "$port" && break
		i=$((i + 1))
		sleep 2
	done

	if port_listening "$port"; then
		echo "== 完成：$ver，地址 http://$(host_ip):$port"
		set_phase "done:$ver"
		return 0
	fi

	echo "== 端口没起来，看日志"
	logread 2>/dev/null | grep -i "workbuddy\|wb-proxy" | tail -n 20
	set_phase "error:服务没起来，见上方日志"
	return 1
}

# ---------------------------------------------------------------- 容器
compose_bin() {
	if docker_live && docker compose version >/dev/null 2>&1; then
		echo "docker compose"
		return 0
	fi
	command -v docker-compose >/dev/null 2>&1 && {
		echo "docker-compose"
		return 0
	}
	return 1
}

compose() {
	local bin
	bin=$(compose_bin) || return 1
	# shellcheck disable=SC2086
	$bin -p "$CT_NAME" -f "$COMPOSE_FILE" "$@"
}

yaml_q() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

compose_write() {
	local tag="$1" port="$2" dir="$3" src="${4:-official}" tz

	tz=$(uci -q get system.@system[0].zonename)
	[ -n "$tz" ] || tz="Asia/Shanghai"

	mkdir -p "$dir/accounts" "$dir/usage" || return 1

	{
		echo "# 由 luci-app-workbuddy2api / luci-app-hub 生成，重新安装/更新会覆盖。"
		echo "# 本地版与容器版共用 $dir 下的 accounts/ 与 usage/，换实现不丢数据。"
		echo "services:"
		echo "  $CT_NAME:"
		echo "    image: $(yaml_q "$(img_of "$src"):${tag:-latest}")"
		echo "    container_name: $CT_NAME"
		echo "    restart: unless-stopped"
		echo "    # host 网络：容器内端口就是宿主端口，局域网直连，不用管桥接转发"
		echo "    network_mode: host"
		echo "    environment:"
		echo "      TZ: $(yaml_q "$tz")"
		echo "      HOST: '0.0.0.0'"
		echo "      PORT: $(yaml_q "$port")"
		echo "      # 面板每 5 秒轮询一次，缓存过期就要全量重扫 usage.jsonl，"
		echo "      # 在这台路由器上要十几秒。900 秒是能正常用的下限。"
		echo "      WB_STATS_TTL: '900'"
		echo "      WB_COUNT_TTL: '900'"
		echo "    volumes:"
		echo "      - $(yaml_q "$dir/accounts:/app/accounts")"
		echo "      - $(yaml_q "$dir/usage:/app/usage")"
		echo "      - $(yaml_q "$dir/subbridge-data:/app/subbridge-data")"
	} >"$COMPOSE_FILE" || return 1

	return 0
}

worker_ct_up() {
	local tag="$1" port="$2" dir="$3" src="${4:-official}" i=0
	local img="$(img_of "$src"):${1:-latest}"

	DATADIR="$dir"

	if compose_bin >/dev/null 2>&1; then
		echo "== compose pull $img"
		set_phase "pulling:$tag"
		compose pull || echo "== pull 有告警，继续（本地可能已有该镜像）"

		echo "== compose up -d"
		set_phase "starting:$tag"
		compose up -d || {
			set_phase "error:compose up 失败，看上面的输出"
			return 1
		}
	else
		echo "== 没有 docker compose，先拉镜像再用 docker run"
		set_phase "pulling:$tag"
		docker pull "$img" || {
			set_phase "error:拉不动 $img"
			return 1
		}
		docker rm -f "$CT_NAME" >/dev/null 2>&1
		docker run -d --name "$CT_NAME" --restart unless-stopped \
			--network host -e "TZ=$(uci -q get system.@system[0].zonename)" \
			-e "HOST=0.0.0.0" -e "PORT=$port" \
			-e WB_STATS_TTL=900 -e WB_COUNT_TTL=900 \
			-v "$dir/accounts:/app/accounts" -v "$dir/usage:/app/usage" \
			-v "$dir/subbridge-data:/app/subbridge-data" \
			"$img" || {
			set_phase "error:docker run 失败，看上面的输出"
			return 1
		}
	fi

	echo "== 等面板起来"
	set_phase "starting:$tag"
	while [ $i -lt 60 ]; do
		ct_running && port_listening "$port" && break
		i=$((i + 1))
		sleep 3
	done

	if ! ct_running; then
		echo "== 容器没起来"
		docker logs --tail 40 "$CT_NAME" 2>&1
		set_phase "error:容器没起来，看上面的日志"
		return 1
	fi

	echo "== 完成，地址 http://$(host_ip):$port"
	set_phase "done:$tag"
	return 0
}

# ---------------------------------------------------------------- 安装入口
cmd_install() {
	local variant="$1" port="$2" dir="$3" tag="$4"
	local kind src overlay_kb

	[ -n "$port" ] || port="$PORT"
	[ -n "$dir" ] || dir="$DATADIR"

	case "$dir" in
		/mnt/* | /opt/*) ;;
		*)
			echo "数据目录必须在 /mnt 或 /opt 下（当前：$dir）" >&2
			echo "账号凭据与用量日志都写这里；放 overlay 会写满 flash，刷机也会丢。" >&2
			return 2
			;;
	esac

	case "$port" in
		'' | *[!0-9]*)
			echo "端口必须是数字（当前：$port）" >&2
			return 1
			;;
	esac

	case "$variant" in
		python | python-docker | python-ce | python-docker-ce) ;;
		rust | rust-docker)
			echo "Rust 版已经不再提供：上游 YTjungle666/workbuddy2api-hub 已删库，" >&2
			echo "拿不到版本号和二进制。旧的可以 remove 清掉，然后装下面四种之一。" >&2
			return 1
			;;
		*)
			echo "未知的安装方式：$variant" >&2
			return 1
			;;
	esac

	check_exclusive "$variant" || return 4

	kind=$(kind_of "$variant")
	src=$(src_of "$variant")

	mkdir -p "$dir/accounts" "$dir/usage" || {
		echo "无法创建 $dir" >&2
		return 1
	}
	chmod 700 "$dir/accounts" 2>/dev/null

	# 首次安装可能换了目录：compose 文件与 .version/.source 都跟着这次选的目录走
	# （脚本顶部的 DATADIR 是从 uci 读的，这个进程里可能还是上一次的值）
	DATADIR="$dir"
	COMPOSE_FILE="$dir/docker-compose.yml"

	case "$kind" in
		python)
			overlay_kb=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')
			if [ -n "$overlay_kb" ] && [ "$overlay_kb" -lt 102400 ]; then
				echo "overlay 剩余不足 100MB（当前 $((overlay_kb / 1024))MB）。" >&2
				echo "本地版会连带装 python3 等约 15MB 依赖。" >&2
				return 3
			fi
			[ -n "$tag" ] || tag=$(gh_latest_release "$(repo_of "$src")")
			[ -n "$tag" ] || {
				echo "取不到上游版本号（GitHub 不通？）" >&2
				return 1
			}
			save_cfg python "$port" "$dir"
			write_src python "$src"
			spawn_task "downloading:$tag" "安装$(label_of "$variant") $tag" \
				_worker_python "$tag" "$port" "$dir" "$src"
			;;
		python-docker)
			docker_live || {
				echo "Docker 没在跑，容器版装不了。" >&2
				return 1
			}
			[ -n "$tag" ] || tag=$(gh_latest_release "$(repo_of "$src")")
			[ -n "$tag" ] || {
				echo "取不到上游版本号（GitHub 不通？）" >&2
				return 1
			}
			compose_write "$tag" "$port" "$dir" "$src" || {
				echo "写不了 $COMPOSE_FILE" >&2
				return 1
			}
			save_cfg python-docker "$port" "$dir"
			write_src python-docker "$src"
			spawn_task "pulling:$tag" "安装$(label_of "$variant") $tag" \
				_worker_ct_up "$tag" "$port" "$dir" "$src"
			;;
	esac

	return 0
}

# ---------------------------------------------------------------- 更新
cmd_update() {
	local variant="$1" kind src tag st

	if [ -z "$variant" ]; then
		st=$(cmd_status)
		kind=$(echo "$st" | sed -n 's/^kind=//p')
		src=$(echo "$st" | sed -n 's/^source=//p')
		case "$kind" in
			python | python-docker)
				[ "$src" = "community" ] && variant="$kind-ce" || variant="$kind"
				;;
		esac
	fi

	kind=$(kind_of "$variant")
	if [ -z "$kind" ]; then
		echo "没有安装任何一套，或安装方式不认识：$variant" >&2
		return 1
	fi
	src=$(src_of "$variant")

	case "$kind" in
		python)
			py_present || {
				echo "没装本地版" >&2
				return 1
			}
			tag=$(gh_latest_release "$(repo_of "$src")")
			[ -n "$tag" ] || {
				echo "取不到上游版本号" >&2
				return 1
			}
			if [ "$(vnum "$tag")" = "$(ver_python)" ] && [ "$(read_src python)" = "$src" ]; then
				echo "已经是最新版：$(ver_python)"
				return 0
			fi
			spawn_task "downloading:$tag" "升级$(label_of "$variant") 到 $tag" \
				_worker_python "$tag" "$PORT" "$DATADIR" "$src"
			;;
		python-docker)
			pd_present || {
				echo "没装容器版" >&2
				return 1
			}
			tag=$(gh_latest_release "$(repo_of "$src")")
			[ -n "$tag" ] || {
				echo "取不到上游版本号" >&2
				return 1
			}
			compose_write "$tag" "$PORT" "$DATADIR" "$src"
			write_src python-docker "$src"
			spawn_task "pulling:$tag" "升级$(label_of "$variant") 到 $tag" \
				_worker_ct_up "$tag" "$PORT" "$DATADIR" "$src"
			;;
	esac

	return 0
}

# ---------------------------------------------------------------- 生命周期
cmd_lifecycle() {
	local variant="$1" act="$2"

	case "$variant" in
		python | python-ce)
			[ -x "$PY_INIT" ] || {
				echo "没装本地版" >&2
				return 1
			}
			[ "$act" = "start" ] && "$PY_INIT" enable >/dev/null 2>&1
			"$PY_INIT" "$act" 2>&1
			;;
		rust)
			[ -x "$RS_INIT" ] || {
				echo "没有遗留的本地·Rust" >&2
				return 1
			}
			[ "$act" = "start" ] && "$RS_INIT" enable >/dev/null 2>&1
			"$RS_INIT" "$act" 2>&1
			;;
		python-docker | python-docker-ce | rust-docker)
			ct_running >/dev/null 2>&1 || [ -n "$(ct_state)" ] || {
				echo "没有 wb-proxy 容器" >&2
				return 1
			}
			# 端口可能在页面上刚改过：重写 compose 再 up -d，compose 会发现
			# 配置变了并重建容器（账号、用量都在挂载目录里，不会丢）。
			# 直接 compose start 只会把旧容器拉起来，改的端口不生效。
			tag=$(ct_image 2>/dev/null)
			tag=${tag##*:}
			case "$tag" in
				'' | */*) tag=latest ;;
			esac
			compose_write "$tag" "$PORT" "$DATADIR" "$(read_src python-docker)" || return 1
			case "$act" in
				start | restart)
					if compose_bin >/dev/null 2>&1; then
						compose up -d 2>&1 || docker restart "$CT_NAME" 2>&1
					else
						docker restart "$CT_NAME" 2>&1
					fi
					;;
				*)
					if compose_bin >/dev/null 2>&1; then
						compose "$act" 2>&1 || docker "$act" "$CT_NAME" 2>&1
					else
						docker "$act" "$CT_NAME" 2>&1
					fi
					;;
			esac
			;;
		*)
			echo "未知的安装方式：$variant" >&2
			return 1
			;;
	esac

	return 0
}

cmd_remove() {
	local variant="$1" purge="$2" dir

	dir="$DATADIR"

	case "$variant" in
		python | python-ce)
			[ -x "$PY_INIT" ] && "$PY_INIT" stop >/dev/null 2>&1
			[ -x "$PY_INIT" ] && "$PY_INIT" disable >/dev/null 2>&1
			case "$(pkg_mgr)" in
				apk) apk del workbuddy2api 2>&1 ;;
				opkg) opkg remove workbuddy2api 2>&1 ;;
			esac
			rm -f "$(ver_file python)" "$(src_file python)"
			;;
		rust)
			[ -x "$RS_INIT" ] && "$RS_INIT" stop >/dev/null 2>&1
			[ -x "$RS_INIT" ] && "$RS_INIT" disable >/dev/null 2>&1
			rm -f "$RUST_BIN" "$(ver_file rust)"
			;;
		python-docker | python-docker-ce | rust-docker)
			if compose_bin >/dev/null 2>&1 && [ -f "$COMPOSE_FILE" ]; then
				compose down >/dev/null 2>&1
			fi
			docker rm -f "$CT_NAME" >/dev/null 2>&1
			rm -f "$COMPOSE_FILE" "$(src_file python-docker)"
			;;
		*)
			echo "未知的安装方式：$variant" >&2
			return 1
			;;
	esac

	if [ "$purge" = "purge" ]; then
		rm -rf "$dir/accounts" "$dir/usage" "$dir/subbridge-data"
		rm -f "$dir"/.wb2api-*.version "$dir"/.wb2api-*.source
		echo "已卸载并删除数据：$dir"
	else
		echo "已卸载，数据保留在：$dir"
	fi

	return 0
}

cmd_logs() {
	local variant="$1"

	if [ -s "$TASK_DIR/log" ]; then
		echo "== 任务日志 =="
		tail -n 40 "$TASK_DIR/log"
		echo
	fi

	case "$variant" in
		python | python-ce | rust)
			echo "== 服务日志 =="
			logread 2>/dev/null | grep -iE "workbuddy|wb-proxy|wb-backend" | tail -n 40
			;;
		*)
			echo "== 容器日志 =="
			docker logs --tail 60 "$CT_NAME" 2>&1
			;;
	esac
}

# ---------------------------------------------------------------- 入口
case "${1:-}" in
	status) cmd_status ;;
	latest) cmd_latest "${2:-all}" ;;
	disks) cmd_disks ;;
	install) cmd_install "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
	update) cmd_update "${2:-}" ;;
	start | stop | restart) cmd_lifecycle "${2:-}" "$1" ;;
	remove) cmd_remove "${2:-}" "${3:-}" ;;
	logs) cmd_logs "${2:-}" ;;
	_worker_python) shift; worker_python "$@" ;;
	_worker_ct_up) shift; worker_ct_up "$@" ;;
	*)
		cat >&2 <<-EOF
			用法：workbuddy2api-ctl <命令>

			  status                          四套的完整状态
			  latest [official|community|all]  查两个上游的最新版本
			  disks                           /mnt 与 /opt 下的数据目录候选

			  install <安装方式> [端口] [数据目录] [版本]
			    本地·原版      python
			    容器·原版      python-docker
			    本地·社区版    python-ce
			    容器·社区版    python-docker-ce

			  update <安装方式>
			  start|stop|restart <安装方式>
			  remove <安装方式> [purge]
			  logs <安装方式>
		EOF
		exit 1
		;;
esac

exit $?

#!/bin/sh
# luci-app-hub 的后端：qBittorrent（4 种运行方式）与 OpenList（3 种）。
#
# 1Panel 和 WorkBuddy2API 的 ctl 原样放进同一个包，本脚本不重写它们的逻辑，
# 页面直接调各自的 ctl —— 这两个已经跑稳了，为了"合并"再动一遍没有收益。
#
# qBittorrent
#   luci       原生官方包 qbittorrent（feeds）
#   luci-ee    原生增强版 qbittorrent-enhanced-edition（同二进制名、同一份 init）
#   docker     容器官方版 lscr.io/linuxserver/qbittorrent
#   docker-ee  容器增强版 p3terx/qbittorrent-enhanced
#
# OpenList
#   feeds      官方 openlist 包，数据 /etc/openlist
#   openlist2  sbwml/luci-app-openlist2，数据 /etc/openlist2
#   docker     容器版 openlistteam/openlist
#
# 数据目录优先级（按用户要求：优先 sda1，其次与 luci 版同位置）
#   1. hub.<name>.datadir 显式指定
#   2. /mnt/sda1 存在可写 → /mnt/sda1/Configs/services/<name>
#   3. 该服务原生版的数据目录（/etc/qBittorrent、/etc/openlist2 …）

SELF=$(readlink -f "$0" 2>/dev/null || echo /usr/libexec/hub-ctl)
TASK_DIR="/var/run/hub-task"

QBT_IMG_STD="lscr.io/linuxserver/qbittorrent:latest"
QBT_IMG_EE="superng6/qbittorrentee:latest"
OL_IMG="openlistteam/openlist:latest"

QBT_CT="qbittorrent"
OL_CT="openlist"

DATA_ROOT_DEFAULT="/mnt/sda1/Configs"
DATA_ROOT_ALT="/opt/Configs"

# ---------------------------------------------------------------- 配置存取
cfg() {
	uci -q get "hub.$1" 2>/dev/null
}

cfg_def() {
	local v
	v=$(cfg "$1")
	[ -n "$v" ] && echo "$v" || echo "$2"
}

# save_cfg <section-key> [k=v ...]，section-key 就是段名，如 qbittorrent
save_cfg() {
	local sec="$1" kv
	shift

	uci -q get "hub.$sec" >/dev/null 2>&1 || {
		case "$sec" in
		global) uci -q set "hub.$sec=hub" ;;
		*) uci -q set "hub.$sec=service" ;;
		esac
	}
	for kv in "$@"; do
		uci -q set "hub.$sec.${kv%%=*}=${kv#*=}"
	done
	uci -q commit hub
}

# ---------------------------------------------------------------- 基础工具
arch_name() {
	case "$(uname -m)" in
	aarch64) echo "aarch64" ;;
	x86_64) echo "x86_64" ;;
	armv7*) echo "armv7" ;;
	*) uname -m ;;
	esac
}

# 页面上的访问地址一律用 LAN 地址。
# 不能用「默认路由那个接口的地址」—— 那是 WAN 口（光猫给路由器分的 192.168.1.x），
# 和 1panel-ctl / workbuddy2api-ctl 的算法不一致，页面上会出现两套 IP。
lan_ip() {
	local ip

	ip=$(uci -q get network.lan.ipaddr)
	ip=${ip%%/*}

	if [ -z "$ip" ]; then
		ip=$(ip -4 addr show br-lan 2>/dev/null |
			awk '/inet /{sub(/\/.*/, "", $2); print $2; exit}')
	fi

	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr)
	echo "${ip:-192.168.1.1}"
}

have_docker() { command -v docker >/dev/null 2>&1; }

# status 一次执行里会问好几遍「docker 在不在」，每次 docker info 都要
# 连一次 socket，在 OpenWrt 上是实打实的几十毫秒，缓存下来只问一次。
DOCKER_LIVE=""
docker_live() {
	[ -n "$DOCKER_LIVE" ] && [ "$DOCKER_LIVE" = 1 ] && return 0
	[ "$DOCKER_LIVE" = 0 ] && return 1

	have_docker && docker info >/dev/null 2>&1 || {
		DOCKER_LIVE=0
		return 1
	}

	DOCKER_LIVE=1
	return 0
}

# /proc/net/tcp 的本地地址形如 0100007F:1F90，端口是冒号后的 4 位十六进制。
# 不依赖 ss/netstat —— OpenWrt 上 ss 不一定存在，前面排查端口时就吃过这个亏。
port_listening() {
	local p="$1" hex
	[ -n "$p" ] || return 1
	hex=$(printf '%04X' "$p" 2>/dev/null) || return 1
	awk -v h=":$hex" 'NR>1 && substr($2, length($2)-4) == h {f=1} END{exit !f}' \
		/proc/net/tcp /proc/net/tcp6 2>/dev/null
}

ct_state() {
	docker_live || return 1
	docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null
}

ct_present() { [ -n "$(ct_state "$1")" ]; }

ct_running() { [ "$(ct_state "$1")" = "running" ]; }

# 容器镜像存在哪。落在 /mnt 上刷机不受影响，落在 overlay 上既吃空间、
# 又会在 sysupgrade 后一起没掉（overlay 被清空）。
docker_root() {
	docker_live || return 0
	docker info --format '{{.DockerRootDir}}' 2>/dev/null
}

compose_bin() {
	if docker_live && docker compose version >/dev/null 2>&1; then
		echo "docker compose"
		return 0
	fi
	command -v docker-compose >/dev/null 2>&1 && {
		echo "docker-compose"
		return 0
	}
	return 1
}

# compose <project> <file> <args...>
compose() {
	local proj="$1" file="$2" bin
	shift 2
	bin=$(compose_bin) || return 1
	# shellcheck disable=SC2086
	$bin -p "$proj" -f "$file" "$@"
}

yaml_q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }

# ---------------------------------------------------------------- 包管理
pkg_mgr() {
	if command -v apk >/dev/null 2>&1; then
		echo apk
	elif command -v opkg >/dev/null 2>&1; then
		echo opkg
	fi
}

pkg_installed() {
	case "$(pkg_mgr)" in
	apk) apk info -e "$1" >/dev/null 2>&1 ;;
	opkg) opkg list-installed 2>/dev/null | grep -q "^$1 " ;;
	*) return 1 ;;
	esac
}

pkg_add() {
	case "$(pkg_mgr)" in
	apk) apk update >/dev/null 2>&1; apk add "$@" ;;
	opkg) opkg update >/dev/null 2>&1; opkg install "$@" ;;
	*) return 1 ;;
	esac
}

pkg_del() {
	case "$(pkg_mgr)" in
	# 切换官方版/增强版时，另一端往往还被 luci-app-* 依赖着，直接删会被拒。
	# 先按常规删，不行再放宽依赖检查 —— 反正紧接着就要装另一个。
	apk)
		apk del "$@" >/dev/null 2>&1 || apk del --force-broken-world "$@" 2>/dev/null
		;;
	opkg)
		opkg remove "$@" >/dev/null 2>&1 || opkg remove --force-depends "$@" 2>/dev/null
		;;
	*) return 1 ;;
	esac
}

# ---------------------------------------------------------------- 任务
task_phase() {
	[ -s "$TASK_DIR/state" ] && cat "$TASK_DIR/state" 2>/dev/null || echo "idle"
}

set_phase() {
	mkdir -p "$TASK_DIR"
	echo "$1" >"$TASK_DIR/state"
}

spawn_task() {
	local phase="$1" label="$2" log="$TASK_DIR/log"
	shift 2

	mkdir -p "$TASK_DIR"
	: >"$log"
	set_phase "$phase"

	if command -v setsid >/dev/null 2>&1; then
		setsid "$SELF" "$@" </dev/null >>"$log" 2>&1 &
	else
		("$SELF" "$@" </dev/null >>"$log" 2>&1 &)
	fi

	echo "已开始：$label"
	echo "任务在后台执行，完成后刷新本页；日志：$log"
}

# ---------------------------------------------------------------- 数据目录
# 目录所在分区的剩余空间（KB），与 1panel-ctl / workbuddy2api-ctl 的字段同名，
# 页面顶部状态卡统一显示。
free_kb() {
	df -k "$1" 2>/dev/null | awk 'NR==2 {print $4}'
}

is_mnt_ok() {
	[ -d /mnt/sda1 ] && [ -w /mnt/sda1 ] && mountpoint -q /mnt/sda1 2>/dev/null
}

opt_ok() { [ -d /opt ] && [ -w /opt ]; }

# 数据根只有两处：/mnt/sda1/Configs（有数据盘时）和 /opt/Configs。
# 服务目录直接挂在下面一层：/mnt/sda1/Configs/qbittorrent，不再多套 services。
data_root() {
	local d
	d=$(cfg global.datadir)
	if [ -n "$d" ]; then
		echo "$d"
	elif is_mnt_ok; then
		echo "$DATA_ROOT_DEFAULT"
	else
		echo "$DATA_ROOT_ALT"
	fi
}

# 各服务原生版的数据目录，容器版选"跟随 luci"时也用它。
native_datadir() {
	case "$1" in
	qbittorrent) echo "/etc/qBittorrent" ;;
	openlist)
		case "$(ol_variant)" in
		feeds) echo "/etc/openlist" ;;
		*) echo "/etc/openlist2" ;;
		esac
		;;
	esac
}

# svc_datadir <svc> —— 显式 > /mnt/sda1/Configs > /opt/Configs > 原生位置
svc_datadir() {
	local svc="$1" explicit
	explicit=$(cfg "$1.datadir")
	if [ -n "$explicit" ]; then
		echo "$explicit"
	elif is_mnt_ok || opt_ok; then
		echo "$(data_root)/$svc"
	else
		native_datadir "$svc"
	fi
}

# ================================================================ qBittorrent

# 变体 id 是给脚本和 UCI 用的，页面上、日志里一律用中文名 ——
# 不然任务条上会冒出一句「正在安装 docker-ee」，没人看得懂。
qb_variant_label() {
	case "$1" in
	luci) echo "原生·官方版" ;;
	luci-ee) echo "原生·增强版" ;;
	docker) echo "容器·官方版" ;;
	docker-ee) echo "容器·增强版" ;;
	*) echo "$1" ;;
	esac
}

ol_variant_label() {
	case "$1" in
	openlist2) echo "原生·openlist2" ;;
	feeds) echo "原生·feeds 版" ;;
	docker) echo "容器版" ;;
	*) echo "$1" ;;
	esac
}

qb_variant() { cfg_def qbittorrent.variant luci; }
qb_port() { cfg_def qbittorrent.port 8090; }
# bridge 网络下宿主机映射端口，默认与容器内端口相同
qb_host_port() { cfg_def qbittorrent.host_port "$(qb_port)"; }
qb_bt_port() { cfg_def qbittorrent.bt_port 21142; }
# qB 只跑 host：BT 要接大量入站连接，bridge 下走 NAT、还要为 BT 端口单独映射，
# 用起来只会更难查问题。页面上也不再给这个选项。
qb_net() { echo host; }
qb_downloads() { cfg_def qbittorrent.downloads "/mnt/sda1/movie"; }
qb_datadir() { svc_datadir qbittorrent; }
qb_compose() { echo "$(qb_datadir)/docker-compose.yml"; }
qb_image() {
	case "$(qb_variant)" in
	docker-ee) cfg_def qbittorrent.image "$QBT_IMG_EE" ;;
	*) cfg_def qbittorrent.image "$QBT_IMG_STD" ;;
	esac
}

# conf 里真正生效的端口。
#
# UCI 里的 port 只是「下次启动要写进去的目标值」：用户完全可能直接在 qB 自己的
# WebUI 里改端口，那时 conf 才是事实。页面上要显示、要拿来拼访问地址的，
# 必须是这个实际在听的值，否则就会出现「设置里写 8090、其实在听 9091」。
#
# 原生版在跑时，活的那份在 /etc/qBittorrent（datadir 只是它的副本），
# 所以先看 /etc；没有原生版（或容器版）时看 datadir。
qb_conf_file() {
	local nat=/etc/qBittorrent/config/qBittorrent.conf
	local dir ctr old cached

	dir=$(qb_datadir)
	# qB 的 profile 布局是 <profile>/qBittorrent/config/qBittorrent.conf：
	#   原生版  --profile=/etc      → /etc/qBittorrent/config/qBittorrent.conf
	#   容器版  --profile=/config   → <数据目录>/config/qBittorrent/config/qBittorrent.conf
	# 少一层 qBittorrent/ 那个是早期版本写错的位置，留着兼容，读到就用。
	ctr="$dir/config/qBittorrent/config/qBittorrent.conf"
	old="$dir/config/qBittorrent.conf"

	[ -f "$nat" ] && { echo "$nat"; return; }

	# 容器版真实路径由镜像的 profile 决定，第一个装上的镜像探测一次就记在
	# <数据目录>/.confpath，之后直接照着用
	if [ -s "$dir/.confpath" ]; then
		cached=$(cat "$dir/.confpath" 2>/dev/null)
		[ -n "$cached" ] && [ -f "$cached" ] && { echo "$cached"; return; }
	fi

	[ -f "$ctr" ] && { echo "$ctr"; return; }
	[ -f "$old" ] && { echo "$old"; return; }

	# 一个都还没有（刚装、容器还没起）时，返回容器版该待的位置
	echo "$ctr"
}

# 让容器自己说出 conf 在哪（镜像的 profile 布局不一定和我们的猜测一致）。
# 只在容器跑着的时候能做，结果写进 <数据目录>/.confpath，之后不再 find。
qb_conf_probe() {
	local dir real cache

	dir=$(qb_datadir)
	cache="$dir/.confpath"

	ct_running "$QBT_CT" || return 0

	real=$(docker exec "$QBT_CT" find /config -name qBittorrent.conf 2>/dev/null | head -n 1)
	case "$real" in
	/config/*)
		real="$dir${real#/config}"
		[ -f "$real" ] && echo "$real" >"$cache"
		;;
	esac
	return 0
}

# $1 形如 WebUI\Port / Session\Port —— 用 awk 按整键名比较，反斜杠是普通字符。
# 注意：不能用 `awk -v k=...`，awk 的 -v 会解释转义，`\P` 会被吞成 `P`
# 导致永远匹配不上；走 ENVIRON 传参不做转义。
qb_conf_port() {
	local f v

	f=$(qb_conf_file)
	[ -f "$f" ] || return 0

	v=$(K="$1" awk -F= '$1 == ENVIRON["K"] { print $2; exit }' "$f" 2>/dev/null | tr -d '\r')
	case "$v" in
	'' | *[!0-9]*) return 0 ;;
	esac
	echo "$v"
}

qb_live_port() {
	local p
	p=$(qb_conf_port 'WebUI\Port')
	echo "${p:-$(qb_port)}"
}

qb_live_bt_port() {
	local p
	p=$(qb_conf_port 'Session\Port')
	echo "${p:-$(qb_bt_port)}"
}

# 原生版装的是哪一个：std / ee / 空
qb_native_kind() {
	if pkg_installed qbittorrent-enhanced-edition; then
		echo ee
	elif pkg_installed qbittorrent; then
		echo std
	elif [ -x /usr/bin/qbittorrent-nox ]; then
		echo std
	fi
}

qb_native_running() {
	[ -x /etc/init.d/qbittorrent ] || return 1
	/etc/init.d/qbittorrent status >/dev/null 2>&1
}

qb_compose_write() {
	local f port bt net dir cfgdir dl img kind

	f=$(qb_compose)
	port=$(qb_port)
	bt=$(qb_bt_port)
	net=$(qb_net)
	dir=$(qb_datadir)
	img=$(qb_image)
	dl=$(qb_downloads)

	# 每个镜像的约定都不一样，不能共用一份 compose：
	#   linuxserver（官方版）  挂 /config，端口 WEBUI_PORT / TORRENTING_PORT
	#   superng6（增强版）     挂 /config，端口 WEBUIPORT（没有下划线）
	# 两边的 conf 都落在 <dir>/config/qBittorrent.conf，页面读的是同一个文件。
	# p3terx 那版虽然也叫增强版，但停更在 4.4，早就不用了，分支留着是防有人手改镜像名。
	case "$img" in
	*p3terx*) kind=p3terx ;;
	*superng6*) kind=superng6 ;;
	*) kind=lsio ;;
	esac

	# 配置目录跟着数据目录走：里面是 qBittorrent.conf 与 BT_backup，
	# 丢了等于把种子和做种记录全丢，必须落在可保留的位置。
	cfgdir="$dir/config"

	mkdir -p "$cfgdir" "$dl" || return 1

	{
		echo "# 由 luci-app-hub 生成，修改会被覆盖。"
		echo "services:"
		echo "  $QBT_CT:"
		echo "    image: $(yaml_q "$img")"
		echo "    container_name: $QBT_CT"
		echo "    hostname: qbittorrent"
		echo "    restart: unless-stopped"
		if [ "$net" = "host" ]; then
			echo "    network_mode: host"
		else
			# 容器内监听的仍是 $port（WEBUI_PORT / conf 里都是它），
			# 宿主机侧用单独配的 host_port，两者可以不同。
			echo "    ports:"
			echo "      - '$(qb_host_port):$port/tcp'"
			echo "      - '$bt:$bt/tcp'"
			echo "      - '$bt:$bt/udp'"
		fi
		echo "    environment:"
		echo "      TZ: $(yaml_q "$(uci -q get system.@system[0].zonename || echo Asia/Shanghai)")"
		echo "      PUID: '0'"
		echo "      PGID: '0'"
		case "$kind" in
		p3terx)
			echo "      UMASK_SET: '022'"
			echo "      QBT_WEBUI_PORT: $(yaml_q "$port")"
			;;
		superng6)
			echo "      UMASK: '022'"
			echo "      WEBUIPORT: $(yaml_q "$port")"
			echo "      ENABLE_DOWNLOADS_PERM_FIX: 'true'"
			;;
		*)
			echo "      UMASK: '022'"
			echo "      WEBUI_PORT: $(yaml_q "$port")"
			echo "      TORRENTING_PORT: $(yaml_q "$bt")"
			;;
		esac
		echo "    volumes:"
		if [ "$kind" = p3terx ]; then
			# p3terx 把 /qBittorrent 当 profile 根，整个数据目录挂进去
			echo "      - $(yaml_q "$dir:/qBittorrent")"
		else
			echo "      - $(yaml_q "$cfgdir:/config")"
		fi
		echo "      - $(yaml_q "$dl:/downloads")"
		# 不挂 /etc/localtime：OpenWrt 上它是符号链接，目标常常不存在，
		# Docker 建挂载源时 mkdir 已存在的路径会直接 EEXIST。TZ 已经给了。
	} >"$f" || return 1

	chmod 600 "$f"
	return 0
}

# ---------------------------------------------------------------- 数据目录同步
# 原生版的数据位置是包自己定的（qB 是 --profile=/etc 下的 /etc/qBittorrent，
# openlist2 是 /etc/openlist2，feeds openlist 是 /etc/openlist），容器版挂的却是
# hub 的 datadir。不处理的话「原生 ↔ 容器」互切就是两套毫不相干的数据，
# 换一次版本等于换一个空面板。
#
# 做法：datadir 是唯一真相，原生目录是它的副本。
#   启动前  datadir  → /etc/xxx（整份复制，先清空）
#   停止后  /etc/xxx → datadir （回写）
#   /etc/qBittorrent 是真的目录，不是符号链接 —— ls、备份、文件管理器都正常。
# 层级天然对齐：qB 原生读 <dir>/config/qBittorrent.conf，容器读 /config/…；
# OpenList 原生读 <dir>/data.db，容器读 /opt/openlist/data/data.db。

# 目录里有真数据吗（不存在或空目录都算没有）
has_data() {
	[ -d "$1" ] || return 1
	[ -n "$(ls -A "$1" 2>/dev/null)" ]
}

# datadir → 原生目录：整份铺过去。先清空，免得残留上一次的旧文件。
sync_push() {
	local dir="$1" native="$2" need avail

	[ -n "$dir" ] && [ -n "$native" ] || return 0
	[ "$dir" = "$native" ] && return 0
	has_data "$dir" || return 0

	need=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
	avail=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')

	# overlay 很小，qB 的 BT_backup 有几个种子就几十 MB，装不下就别硬拷，
	# 否则 /etc 会被写满连带系统一起挂。
	if [ -n "$need" ] && [ -n "$avail" ] && [ "$need" -gt "$((avail - 8192))" ]; then
		echo "!! overlay 只剩 $((avail / 1024))MB，放不下 $((need / 1024))MB 的数据" >&2
		return 1
	fi

	rm -rf "$native" || return 1
	mkdir -p "$native" || return 1
	cp -a "$dir/." "$native/" || return 1
	echo "-- $dir → $native（$((need / 1024))MB）"
	return 0
}

# 原生目录 → datadir：把运行期间的写入搬回去（同名覆盖，datadir 里其它文件保留）
sync_pull() {
	local native="$1" dir="$2"

	[ -n "$native" ] && [ -n "$dir" ] || return 0
	[ "$dir" = "$native" ] && return 0
	has_data "$native" || return 0

	mkdir -p "$dir" || return 1
	cp -a "$native/." "$dir/" || return 1
	echo "-- $native → $dir（回写）"
	return 0
}

# 装包前清掉原生目录：apk 往已经存在的目录里解包会报 trying to overwrite，
# 旧文件也会和新包的初始文件混在一起。数据已经回写进 datadir，删了不丢。
clear_native_dir() {
	local native="$1"

	# 老版本（<=0fe8f64）留下的符号链接：rm -rf 只删链接本身，不会动 /mnt
	[ -L "$native" ] && { rm -f "$native"; echo "-- 去掉旧链接 $native"; return 0; }
	[ -d "$native" ] || return 0
	rm -rf "$native" && echo "-- 清空 $native（数据在 datadir 里）"
	return 0
}

# status 里那个 datalink 字段：原生目录已存在且是 datadir 的副本
datacopy_ok() {
	local native="$1" dir="$2"
	[ -d "$native" ] && [ ! -L "$native" ] && has_data "$native" || return 1
	[ "$dir" != "$native" ]
}

qb_stop_all() {
	local had_native
	had_native=0
	[ -n "$(qb_native_kind)" ] && had_native=1

	[ -x /etc/init.d/qbittorrent ] && /etc/init.d/qbittorrent stop >/dev/null 2>&1
	ct_running "$QBT_CT" && docker stop "$QBT_CT" >/dev/null 2>&1
	# qB 收到 SIGTERM 会把内存配置写回 conf，等它退干净再动文件
	sleep 1
	killall -9 qbittorrent-nox >/dev/null 2>&1

	# 停干净了把 /etc 里那份搬回 datadir。
	# 纯容器版时 /etc/qBittorrent 是上一次装原生版留下的旧货，拿它覆盖
	# 容器的数据会把配置改回几天前 —— 所以只在原生版存在时才回写。
	[ "$had_native" = 1 ] && sync_pull /etc/qBittorrent "$(qb_datadir)"
	return 0
}

qb_worker_install() {
	local v
	v=$(qb_variant)
	set_phase "installing:$(qb_variant_label "$v")"

	# 停干净：原生版退出时会把内存配置写回 /etc，qb_stop_all 顺手搬进 datadir
	qb_stop_all

	case "$v" in
	luci)
		echo "== 原生官方版"
		clear_native_dir /etc/qBittorrent
		pkg_installed qbittorrent-enhanced-edition && pkg_del qbittorrent-enhanced-edition
		pkg_add qbittorrent || {
			set_phase "error:安装 qbittorrent 失败"
			return 1
		}
		;;
	luci-ee)
		echo "== 原生增强版"
		clear_native_dir /etc/qBittorrent
		pkg_installed qbittorrent && pkg_del qbittorrent
		pkg_add qbittorrent-enhanced-edition || {
			set_phase "error:安装 qbittorrent-enhanced-edition 失败"
			return 1
		}
		;;
	docker | docker-ee)
		echo "== $(qb_variant_label "$v")"
		qb_compose_write || {
			set_phase "error:写 compose 失败"
			return 1
		}
		compose "$QBT_CT" "$(qb_compose)" pull || echo "== pull 有告警，继续"
		compose "$QBT_CT" "$(qb_compose)" up -d || {
			set_phase "error:compose up 失败"
			return 1
		}
		;;
	*)
		set_phase "error:未知变体 $v"
		return 1
		;;
	esac

	# 原生版把 datadir 铺回 /etc（包管理器刚建了个空目录）；
	# 容器版直接挂 datadir，什么都不用做。
	case "$v" in
	docker | docker-ee) ;;
	*) sync_push "$(qb_datadir)" /etc/qBittorrent >/dev/null 2>&1 ;;
	esac

	# 容器版两个变体共用同一个容器名，光看容器状态分不出装的是哪个，
	# 所以在数据目录里留个标记，页面据此给对应的页签打「已装」。
	case "$v" in
	docker | docker-ee) echo "$v" >"$(qb_datadir)/.docker-variant" 2>/dev/null ;;
	*) rm -f "$(qb_datadir)/.docker-variant" 2>/dev/null ;;
	esac

	save_cfg qbittorrent "variant=$v"

	# 页面上填了 WebUI 密码就一起设上（管道来的环境变量，argv 里看不到）。
	# 放这里是因为密码要等 qB 真的起来才能通过 API 写进去。
	if [ -n "${HUB_PASS:-}" ]; then
		echo "== 设置 WebUI 密码"
		qb_set_password - || echo "!! 密码没设上，稍后可以在页面上重试" >&2
	fi

	set_phase "done"
	echo "== 完成"
}

# 直接改 qBittorrent.conf 里的两个端口。conf 不存在（还没装）就什么都不做。
#
# datadir 那份是真相，/etc 那份是原生版正在用的副本 —— 两份都要改，
# 否则下次启动 sync_push 会把 datadir 的旧值盖回去。
qb_write_conf_port() {
	local port="$1" bt="$2" dir conf

	dir=$(qb_datadir)

	# 原生版活的那份、容器版该有的那份、以及早期写错位置的那份，谁在就改谁
	for conf in \
		"/etc/qBittorrent/config/qBittorrent.conf" \
		"$dir/config/qBittorrent/config/qBittorrent.conf" \
		"$dir/config/qBittorrent.conf"; do
		[ -f "$conf" ] || continue
		awk -v p="$port" -v b="$bt" '
			/^WebUI\\Port=/   { print "WebUI\\Port=" p; next }
			/^Session\\Port=/ { print "Session\\Port=" b; next }
			{ print }
		' "$conf" >"$conf.hubnew" 2>/dev/null || {
			rm -f "$conf.hubnew"
			continue
		}
		mv -f "$conf.hubnew" "$conf"
	done
	return 0
}

# 把 hub 里配的端口写进各包自己的配置。
# hub 的 UCI 是 hub 的，qB 和 OpenList 的 init 读的是它们自己的段，
# 不同步的话页面上改端口只是改了个没人看的数字。
qb_sync_port() {
	# qB 原生版：init 每次启动都会用 qbittorrent.config.http_port 覆盖 conf
	if uci -q get qbittorrent.config >/dev/null 2>&1; then
		uci -q set "qbittorrent.config.http_port=$(qb_port)"
		uci -q commit qbittorrent
	fi

	# BT 监听端口不在 UCI 里，只能改 conf 的 Session\Port
	qb_write_conf_port "$(qb_port)" "$(qb_bt_port)"
	return 0
}

# OpenList 两个原生包的 UCI 键名不同：openlist2 是 port，
# feeds 版是 listen_http_port（生成 config.json 时用）。
ol_sync_port() {
	local port

	port=$(ol_port)
	if uci -q get openlist2.config >/dev/null 2>&1; then
		uci -q set "openlist2.config.port=$port"
		uci -q commit openlist2
	fi
	if uci -q get openlist.config >/dev/null 2>&1; then
		uci -q set "openlist.config.listen_http_port=$port"
		uci -q commit openlist
	fi
	return 0
}

# 设置 qB 的 WebUI 密码。
#
# 不直接写 PBKDF2：那个格式是 @ByteArray(<salt>:<hash>)，要 100000 轮
# PBKDF2-HMAC-SHA512，shell 里算不出来（openssl kdf 输出的是 hex，转二进制
# 还得绕一圈）。改用 qB 自己的 API：先把 127.0.0.1 加进免密白名单，
# 本机调 setPreferences 就能改密码，qB 自己生成 hash。
#
# 白名单留着是好事：以后忘了密码，从路由器本机还能进去改，LAN 访问照样要密码。
qb_set_password() {
	local pass="$1" port conf i

	# 页面走环境变量传密码（fs.exec 的第三个参数），argv 里只有 "-"，
	# 不会被 ps 看到；命令行手动用时仍然可以直接把密码写在参数里。
	[ "$pass" = "-" ] && pass="$HUB_PASS"

	[ -n "$pass" ] || {
		echo "!! 密码不能为空" >&2
		return 1
	}
	port=$(qb_port)

	# 容器版：刚起来那几秒内探测不到，等一下再问它 conf 在哪
	case "$(qb_variant)" in
	docker | docker-ee)
		i=0
		while [ "$i" -lt 15 ]; do
			ct_running "$QBT_CT" && break
			sleep 1
			i=$((i + 1))
		done
		;;
	esac
	qb_conf_probe

	conf=$(qb_conf_file)

	# 先停：原生版退出时会把内存配置写回 /etc，qb_stop_all 顺手搬进 datadir。
	# 顺序反了的话刚写进去的白名单会被 /etc 的旧副本覆盖掉。
	qb_stop_all

	mkdir -p "${conf%/*}" || return 1

	# 没有 conf 就一次写全：端口、BT 端口、本机免密。
	# 只写个 [LegalNotice] 的话 qB 会用内置默认端口启动，镜像的 WEBUIPORT
	# 也只是 sed 已有的行，不会凭空加一行。
	if [ ! -f "$conf" ]; then
		{
			echo '[LegalNotice]'
			echo 'Accepted=true'
			echo
			echo '[Preferences]'
			echo "WebUI\\Port=$port"
			echo "Session\\Port=$(qb_bt_port)"
			echo 'WebUI\\AuthSubnetWhitelistEnabled=true'
			echo 'WebUI\\AuthSubnetWhitelist=127.0.0.1/32, ::1/128'
		} >"$conf"
	fi

	# 本机免密
	if grep -q '^\[Preferences\]' "$conf"; then
		if grep -q '^WebUI\\AuthSubnetWhitelistEnabled=' "$conf"; then
			sed -i 's|^WebUI\\AuthSubnetWhitelistEnabled=.*|WebUI\\AuthSubnetWhitelistEnabled=true|' "$conf"
		else
			sed -i '/^\[Preferences\]/a WebUI\\AuthSubnetWhitelistEnabled=true' "$conf"
		fi
		if grep -q '^WebUI\\AuthSubnetWhitelist=' "$conf"; then
			sed -i 's|^WebUI\\AuthSubnetWhitelist=.*|WebUI\\AuthSubnetWhitelist=127.0.0.1/32, ::1/128|' "$conf"
		else
			sed -i '/^WebUI\\AuthSubnetWhitelistEnabled=/a WebUI\\AuthSubnetWhitelist=127.0.0.1/32, ::1/128' "$conf"
		fi
	else
		printf '\n[Preferences]\nWebUI\\AuthSubnetWhitelistEnabled=true\nWebUI\\AuthSubnetWhitelist=127.0.0.1/32, ::1/128\n' >>"$conf"
	fi

	qb_start >/dev/null 2>&1

	i=0
	while [ "$i" -lt 30 ]; do
		port_listening "$port" && break
		sleep 1
		i=$((i + 1))
	done
	port_listening "$port" || {
		echo "!! 等不到 $port 端口，密码没改" >&2
		return 1
	}

	curl -s --max-time 10 -o /dev/null -w '' \
		--data-urlencode "json={\"web_ui_password\":\"$pass\"}" \
		"http://127.0.0.1:$port/api/v2/app/setPreferences" || {
		echo "!! 调 qB API 失败" >&2
		return 1
	}

	echo "== 已设置 WebUI 密码（用户名 admin）"
	return 0
}

# 设置 OpenList 管理员密码。二进制自己写库，不用重启。
ol_set_password() {
	local pass v bin dir

	pass="$1"
	[ "$pass" = "-" ] && pass="$HUB_PASS"

	[ -n "$pass" ] || {
		echo "!! 密码不能为空" >&2
		return 1
	}
	v=$(ol_variant)

	case "$v" in
	docker)
		# 安装流程里刚 up -d 完，容器可能还在 starting，等一会儿再 exec
		i=0
		while [ "$i" -lt 20 ]; do
			ct_running "$OL_CT" && break
			sleep 1
			i=$((i + 1))
		done
		ct_running "$OL_CT" || {
			echo "!! 容器没在跑，先把 OpenList 启动起来" >&2
			return 1
		}
		# 用绝对路径：容器的默认工作目录不一定是 /opt/openlist
		docker exec "$OL_CT" /opt/openlist/openlist admin set "$pass"
		;;
	*)
		# 原生版正在跑的话，活库在 /etc/openlist2 或 /etc/openlist，
		# 改那份才有意义（改 datadir 得等下次启动 push 才生效）
		dir=$(ol_datadir)
		case "$(ol_native_kind)" in
		openlist2) has_data /etc/openlist2 && dir=/etc/openlist2 ;;
		feeds) has_data /etc/openlist && dir=/etc/openlist ;;
		esac

		bin=/usr/bin/openlist2
		[ -x "$bin" ] || bin=/usr/bin/openlist
		[ -x "$bin" ] || {
			echo "!! 找不到 openlist 二进制，先安装" >&2
			return 1
		}
		"$bin" --data "$dir" admin set "$pass" || return 1

		# 改的是 /etc 那份就顺手搬回 datadir
		sync_pull "$dir" "$(ol_datadir)"
		;;
	esac
}

qb_start() {
	local v
	v=$(qb_variant)

	# 原生版：把 datadir 那份铺到 /etc（qB 的 --profile 写死在 /etc）
	case "$v" in
	docker | docker-ee) ;;
	*)
		sync_push "$(qb_datadir)" /etc/qBittorrent ||
			echo "!! 数据没铺到 /etc/qBittorrent，qB 会以空配置启动" >&2
		;;
	esac

	# 端口以 hub 里配的为准，写进包自己的 UCI 和 conf
	qb_sync_port

	case "$v" in
	docker | docker-ee)
		# 每次都重写：端口、下载目录、镜像 tag 变了都得让 compose 重算，
		# 只在文件不存在时写会导致「改了端口容器还在旧端口上」。
		qb_compose_write || return 1
		compose "$QBT_CT" "$(qb_compose)" up -d
		;;
	*)
		[ -x /etc/init.d/qbittorrent ] || return 1
		/etc/init.d/qbittorrent start
		;;
	esac
}

qb_stop() {
	qb_stop_all
}

qb_status() {
	local v kind img cstate running listen
	v=$(qb_variant)
	kind=$(qb_native_kind)
	img=$(qb_image)
	cstate=$(ct_state "$QBT_CT" 2>/dev/null)
	running=0
	listen=0
	port_listening "$(qb_live_port)" && listen=1

	case "$v" in
	docker | docker-ee) [ "$cstate" = "running" ] && running=1 ;;
	*) qb_native_running && running=1 ;;
	esac

	echo "qb_variant=$v"
	echo "qb_native=$kind"
	echo "qb_image=$img"
	echo "qb_ct=$cstate"
	echo "qb_docker_variant=$(cat "$(qb_datadir)/.docker-variant" 2>/dev/null)"
	echo "qb_running=$running"
	echo "qb_port=$(qb_port)"
	echo "qb_live_port=$(qb_live_port)"
	echo "qb_host_port=$(qb_host_port)"
	echo "qb_port_busy=$listen"
	echo "qb_bt_port=$(qb_bt_port)"
	echo "qb_live_bt_port=$(qb_live_bt_port)"
	echo "qb_network=$(qb_net)"
	echo "qb_datadir=$(qb_datadir)"
	echo "qb_config=$(qb_datadir)/config"
	echo "qb_downloads=$(qb_downloads)"
	# 原生目录已经是 datadir 的副本（启动前铺、停止后回写）
	if datacopy_ok /etc/qBittorrent "$(qb_datadir)"; then echo "qb_datalink=1"; else echo "qb_datalink=0"; fi
	echo "qb_conflict=$( [ -n "$kind" ] && [ -n "$cstate" ] && echo 1 || echo 0 )"
}

# ================================================================ OpenList
ol_variant() { cfg_def openlist.variant openlist2; }
ol_port() { cfg_def openlist.port 5244; }
ol_host_port() { cfg_def openlist.host_port "$(ol_port)"; }
ol_net() { cfg_def openlist.network host; }
ol_datadir() {
	local explicit
	explicit=$(cfg openlist.datadir)
	if [ -n "$explicit" ]; then
		echo "$explicit"
	elif is_mnt_ok; then
		echo "$(data_root)/openlist"
	else
		native_datadir openlist
	fi
}
ol_compose() { echo "$(ol_datadir)/docker-compose.yml"; }
ol_image() { cfg_def openlist.image "$OL_IMG"; }

# 原生版装了哪一个：feeds(openlist) / openlist2 / 空
ol_native_kind() {
	if pkg_installed openlist2 || [ -x /etc/init.d/openlist2 ]; then
		echo openlist2
	elif pkg_installed openlist || [ -x /etc/init.d/openlist ]; then
		echo feeds
	fi
}

ol_native_running() {
	local k
	k=$(ol_native_kind)
	[ -n "$k" ] || return 1
	[ -x "/etc/init.d/$k" ] && "/etc/init.d/$k" status >/dev/null 2>&1
}

ol_compose_write() {
	local f port net dir img

	f=$(ol_compose)
	port=$(ol_port)
	net=$(ol_net)
	dir=$(ol_datadir)
	img=$(ol_image)

	mkdir -p "$dir" || return 1

	{
		echo "# 由 luci-app-hub 生成，修改会被覆盖。"
		echo "services:"
		echo "  $OL_CT:"
		echo "    image: $(yaml_q "$img")"
		echo "    container_name: $OL_CT"
		echo "    restart: unless-stopped"
		case "$net" in
		host)
			echo "    network_mode: host"
			;;
		bridge)
			echo "    ports:"
			# 容器内固定监听 5244（官方镜像的默认值，端口写在它自己的配置里），
			# 宿主机端口用 host_port。
			echo "      - '$(ol_host_port):5244/tcp'"
			;;
		*)
			# 用户自己建的桥接网络：容器还是听 5244，宿主机侧靠端口映射
			echo "    networks:"
			echo "      - $(yaml_q "$net")"
			echo "    ports:"
			echo "      - '$(ol_host_port):5244/tcp'"
			;;
		esac
		echo "    environment:"
		echo "      TZ: $(yaml_q "$(uci -q get system.@system[0].zonename || echo Asia/Shanghai)")"
		echo "      PUID: '0'"
		echo "      PGID: '0'"
		echo "      UMASK: '022'"
		echo "    volumes:"
		# 官方镜像的数据目录是 /opt/openlist/data，config.json 与 data.db 都在里面
		echo "      - $(yaml_q "$dir:/opt/openlist/data")"
		# 网盘挂载的本地目录：把 /mnt 下真实的挂载点逐个 bind 进去。
		# 不能写 /mnt:/mnt:rslave —— OpenWrt 上 /mnt 通常不是独立挂载点，
		# 父挂载（/）的传播属性又是 private，docker 会直接拒绝：
		#   path /mnt is mounted on / but it is not a shared or slave mount
		mnt_n=0
		for d in /mnt/*; do
			[ -d "$d" ] || continue
			mountpoint -q "$d" 2>/dev/null || continue
			echo "      - $(yaml_q "$d:$d")"
			mnt_n=$((mnt_n + 1))
		done
		[ "$mnt_n" = 0 ] && echo "      - $(yaml_q "/mnt:/mnt")"
		case "$net" in
		host | bridge) ;;
		*)
			echo "networks:"
			echo "  $(yaml_q "$net"):"
			echo "    external: true"
			;;
		esac
	} >"$f" || return 1

	chmod 600 "$f"
	return 0
}

# ---------------------------------------------------------------- openlist2 运行时安装
# openlist2 不在官方 apk 源里（sbwml 的第三方仓库），但作者给每个架构都出了
# 预编译包：releases/latest/download/openwrt-<sdk>-<arch>.tar.gz，解开就是
# packages_ci/ 下的三个包（openlist2、luci-app-openlist2、中文翻译）。
# 所以运行时不用编译，下载解包后本地安装 —— 和作者自己的 install.sh 一个路子。
#
# 为什么不用源码：openlist2 本体是 Go 程序，路由器上没法编译，那个仓库里也
# 只有 Makefile（编译时从 OpenList 源码构建），没有现成二进制。
ol2_arch() {
	local a
	a=$(grep -m1 '^DISTRIB_ARCH=' /etc/openwrt_release 2>/dev/null |
		sed 's/^DISTRIB_ARCH=//' | tr -d '"' | tr -d "'")
	[ -n "$a" ] || a=$(uname -m)
	echo "$a"
}

ol2_sdk() {
	case "$(pkg_mgr)" in
	apk) echo "openwrt-25.12" ;;
	opkg) echo "openwrt-24.10" ;;
	*) return 1 ;;
	esac
}

# 下载并本地安装 openlist2 三件套。直连失败自动换 gh-proxy.com 镜像。
ol2_fetch() {
	local arch sdk file base tmp url ok="" pkg found="" rc

	arch=$(ol2_arch)
	sdk=$(ol2_sdk) || {
		echo "!! 没有可用的包管理器（apk / opkg 都不在）" >&2
		return 1
	}
	file="$sdk-$arch.tar.gz"
	base="https://github.com/sbwml/luci-app-openlist2/releases/latest/download/$file"

	tmp=$(mktemp -d) || return 1
	for url in "$base" "https://gh-proxy.com/$base"; do
		echo "-- 下载 $url"
		if curl -fsSL --connect-timeout 10 --retry 2 -m 600 -o "$tmp/$file" "$url"; then
			ok=1
			break
		fi
		echo "   失败，换下一个地址"
	done
	if [ -z "$ok" ]; then
		echo "!! 下载失败：$file（架构 $arch，SDK $sdk）" >&2
		rm -rf "$tmp"
		return 1
	fi

	tar -xzf "$tmp/$file" -C "$tmp" || {
		echo "!! 解压失败" >&2
		rm -rf "$tmp"
		return 1
	}

	# apk 与 ipk 两种后缀都收，版本号变化不影响匹配
	# shellcheck disable=SC2086
	for pkg in "$tmp"/packages_ci/openlist2-*.apk \
	           "$tmp"/packages_ci/luci-app-openlist2-*.apk \
	           "$tmp"/packages_ci/luci-i18n-openlist2-*.apk \
	           "$tmp"/packages_ci/openlist2_*.ipk \
	           "$tmp"/packages_ci/luci-app-openlist2_*.ipk \
	           "$tmp"/packages_ci/luci-i18n-openlist2-*.ipk; do
		[ -f "$pkg" ] && found="$found $pkg"
	done
	if [ -z "$found" ]; then
		echo "!! 压缩包里没有预期的包（目录结构变了？）" >&2
		rm -rf "$tmp"
		return 1
	fi

	echo "-- 安装：$(printf '%s\n' $found | sed 's#.*/##' | tr '\n' ' ')"
	case "$(pkg_mgr)" in
	# 这些包是作者自签的，不在本机信任链里
	apk) apk add --allow-untrusted $found ;;
	opkg) opkg install --force-downgrade $found ;;
	esac
	rc=$?

	# 重装同一个版本时 apk 可能返回非 0（already installed），
	# 只要包在系统里就算成功。
	if [ "$rc" -ne 0 ] && pkg_installed openlist2; then
		echo "-- 已安装同版本，跳过"
		rc=0
	fi

	rm -rf "$tmp"
	return $rc
}

ol_stop_all() {
	local k
	k=$(ol_native_kind)
	[ -n "$k" ] && [ -x "/etc/init.d/$k" ] && "/etc/init.d/$k" stop >/dev/null 2>&1
	ct_running "$OL_CT" && docker stop "$OL_CT" >/dev/null 2>&1
	sleep 1

	# 原生版的活数据在 /etc，停干净了搬回 datadir
	case "$k" in
	openlist2) sync_pull /etc/openlist2 "$(ol_datadir)" ;;
	feeds) sync_pull /etc/openlist "$(ol_datadir)" ;;
	esac
	return 0
}

ol_worker_install() {
	local v
	v=$(ol_variant)
	set_phase "installing:$(ol_variant_label "$v")"

	# openlist2 与 feeds 版的原生路径不同，但都跟 datadir 同步，
	# 这样三种运行方式（两个原生 + 容器）用的是同一份 data.db。
	ol_stop_all

	case "$v" in
	feeds)
		echo "== feeds 版（官方 openlist）"
		clear_native_dir /etc/openlist
		pkg_installed openlist2 && pkg_del openlist2
		pkg_add openlist || {
			set_phase "error:安装 openlist 失败"
			return 1
		}
		;;
	openlist2)
		echo "== openlist2（sbwml 预编译包）"
		clear_native_dir /etc/openlist2
		pkg_installed openlist && pkg_del openlist
		ol2_fetch || {
			set_phase "error:安装 openlist2 失败（下载或本地安装出错）"
			return 1
		}
		;;
	docker)
		echo "== 容器版"
		ol_compose_write || {
			set_phase "error:写 compose 失败"
			return 1
		}
		compose "$OL_CT" "$(ol_compose)" pull || echo "== pull 有告警，继续"
		compose "$OL_CT" "$(ol_compose)" up -d || {
			set_phase "error:compose up 失败"
			return 1
		}
		;;
	*)
		set_phase "error:未知变体 $v"
		return 1
		;;
	esac

	# 原生版把 datadir 铺回去（包刚建的空目录）；容器版直接挂 datadir
	case "$v" in
	docker) ;;
	feeds) sync_push "$(ol_datadir)" /etc/openlist >/dev/null 2>&1 ;;
	*) sync_push "$(ol_datadir)" /etc/openlist2 >/dev/null 2>&1 ;;
	esac

	save_cfg openlist "variant=$v"

	if [ -n "${HUB_PASS:-}" ]; then
		echo "== 设置管理员密码"
		ol_set_password - || echo "!! 密码没设上，稍后可以在页面上重试" >&2
	fi

	set_phase "done"
	echo "== 完成"
}

ol_start() {
	local v k
	v=$(ol_variant)
	k=$(ol_native_kind)
	[ -n "$k" ] || k="$v"

	# 原生版：datadir 那份铺到 /etc
	case "$v" in
	docker) ;;
	openlist2) sync_push "$(ol_datadir)" /etc/openlist2 || echo "!! 数据没铺到 /etc/openlist2" >&2 ;;
	feeds) sync_push "$(ol_datadir)" /etc/openlist || echo "!! 数据没铺到 /etc/openlist" >&2 ;;
	*)
		case "$k" in
		openlist2) sync_push "$(ol_datadir)" /etc/openlist2 >/dev/null 2>&1 ;;
		feeds) sync_push "$(ol_datadir)" /etc/openlist >/dev/null 2>&1 ;;
		esac
		;;
	esac

	ol_sync_port

	case "$v" in
	docker)
		ol_compose_write || return 1
		compose "$OL_CT" "$(ol_compose)" up -d
		;;
	*)
		[ -x "/etc/init.d/$k" ] || return 1
		"/etc/init.d/$k" start
		;;
	esac
}

ol_stop() { ol_stop_all; }

ol_status() {
	local v kind cstate running listen
	v=$(ol_variant)
	kind=$(ol_native_kind)
	cstate=$(ct_state "$OL_CT" 2>/dev/null)
	running=0
	listen=0
	port_listening "$(ol_port)" && listen=1

	case "$v" in
	docker) [ "$cstate" = "running" ] && running=1 ;;
	*) ol_native_running && running=1 ;;
	esac

	echo "ol_variant=$v"
	echo "ol_native=$kind"
	echo "ol_image=$(ol_image)"
	echo "ol_ct=$cstate"
	echo "ol_running=$running"
	echo "ol_port=$(ol_port)"
	echo "ol_host_port=$(ol_host_port)"
	echo "ol_port_busy=$listen"
	echo "ol_network=$(ol_net)"
	echo "ol_datadir=$(ol_datadir)"
	case "$(ol_native_kind)" in
	openlist2) datacopy_ok /etc/openlist2 "$(ol_datadir)" && echo "ol_datalink=1" || echo "ol_datalink=0" ;;
	feeds) datacopy_ok /etc/openlist "$(ol_datadir)" && echo "ol_datalink=1" || echo "ol_datalink=0" ;;
	*) echo "ol_datalink=0" ;;
	esac
	echo "ol_conflict=$( [ -n "$kind" ] && [ -n "$cstate" ] && echo 1 || echo 0 )"
}

# ================================================================ 命令分发
cmd_status() {
	echo "task=$(task_phase)"
	echo "arch=$(arch_name)"
	echo "docker=$(docker_live && echo 1 || echo 0)"
	echo "mnt=$(is_mnt_ok && echo 1 || echo 0)"
	echo "dataroot=$(data_root)"
	echo "lanip=$(lan_ip)"

	# 容器版要不要提醒「镜像在 overlay 上」，页面据此显示警告
	dr=$(docker_root)
	echo "dockerroot=$dr"
	case "$dr" in
	/mnt/*) echo "dockerroot_ok=1" ;;
	*) echo "dockerroot_ok=0" ;;
	esac
	# 顶部状态卡用的剩余空间：数据盘与 overlay
	echo "data_free_kb=$(free_kb "$(data_root)")"
	echo "overlay_free_kb=$(free_kb /)"
	echo "qb_config_free_kb=$(free_kb "$(qb_datadir)")"
	echo "ol_config_free_kb=$(free_kb "$(ol_datadir)")"

	qb_status
	ol_status
}

cmd_install() {
	local svc="$1" v="$2"
	case "$svc" in
	qbittorrent)
		# 页面按页签选运行方式，所以允许直接带变体过来：装之前先落到 UCI，
		# 后面的 worker 与 start 都读同一个值，不会出现「装了 A 跑了 B」。
		case "$v" in
		luci | luci-ee | docker | docker-ee) save_cfg qbittorrent "variant=$v" ;;
		"") ;;
		*)
			echo "用法：hub-ctl install qbittorrent [luci|luci-ee|docker|docker-ee]" >&2
			return 1
			;;
		esac
		spawn_task "installing:$(qb_variant_label "$(qb_variant)")" "安装 qBittorrent" _worker_qb_install
		;;
	openlist)
		case "$v" in
		openlist2 | feeds | docker) save_cfg openlist "variant=$v" ;;
		"") ;;
		*)
			echo "用法：hub-ctl install openlist [openlist2|feeds|docker]" >&2
			return 1
			;;
		esac
		spawn_task "installing:$(ol_variant_label "$(ol_variant)")" "安装 OpenList" _worker_ol_install
		;;
	*)
		echo "用法：hub-ctl install qbittorrent|openlist [变体]" >&2
		return 1
		;;
	esac
}

# 把端口存成「设置值」：hub 的 UCI + 包自己的 UCI + qBittorrent.conf。
# 页面上「实际在听 8091、设置里是 8090」时，一键把这个值转正。
cmd_setport() {
	local port bt

	port="${1:-}"
	bt="${2:-}"

	case "$port" in
	'' | *[!0-9]*)
		echo "用法：hub-ctl setport <WebUI 端口> [BT 端口]" >&2
		return 1
		;;
	esac

	case "$bt" in
	'') bt=$(qb_bt_port) ;;
	*[!0-9]*)
		echo "BT 端口必须是数字" >&2
		return 1
		;;
	esac

	save_cfg qbittorrent "port=$port" "bt_port=$bt"

	if uci -q get qbittorrent.config >/dev/null 2>&1; then
		uci -q set "qbittorrent.config.http_port=$port"
		uci -q commit qbittorrent
	fi

	qb_write_conf_port "$port" "$bt"
	echo "== 已设为 WebUI $port / BT $bt"
}

# docker 里可用的桥接网络（host/none 对容器没意义，排除）
cmd_networks() {
	docker_live || return 0
	docker network ls --format '{{.Name}}' 2>/dev/null |
		while read -r n; do
			case "$n" in
			host | none) continue ;;
			esac
			echo "net=$n"
		done
	return 0
}

cmd_lifecycle() {
	local svc="$1" act="$2"

	case "$svc:$act" in
	qbittorrent:start) qb_start ;;
	qbittorrent:stop) qb_stop ;;
	qbittorrent:restart)
		qb_stop
		sleep 1
		qb_start
		;;
	openlist:start) ol_start ;;
	openlist:stop) ol_stop ;;
	openlist:restart)
		ol_stop
		sleep 1
		ol_start
		;;
	*)
		echo "用法：hub-ctl <start|stop|restart> qbittorrent|openlist" >&2
		return 1
		;;
	esac
}

cmd_remove() {
	local svc="$1" kind
	case "$svc" in
	qbittorrent)
		qb_stop_all
		if [ -f "$(qb_compose)" ]; then
			compose "$QBT_CT" "$(qb_compose)" down >/dev/null 2>&1
			rm -f "$(qb_compose)"
		fi
		kind=$(qb_native_kind)
		case "$kind" in
		ee) pkg_del qbittorrent-enhanced-edition ;;
		std) pkg_del qbittorrent ;;
		esac
		# 包删了但 /etc 下的副本可能还在，清掉，免得页面还认为「已装」/「已同步」
		killall -9 qbittorrent-nox >/dev/null 2>&1
		clear_native_dir /etc/qBittorrent
		docker rmi "$(qb_image)" >/dev/null 2>&1
		rm -f "$(qb_datadir)/.docker-variant" 2>/dev/null
		;;
	openlist)
		ol_stop_all
		if [ -f "$(ol_compose)" ]; then
			compose "$OL_CT" "$(ol_compose)" down >/dev/null 2>&1
			rm -f "$(ol_compose)"
		fi
		kind=$(ol_native_kind)
		case "$kind" in
		openlist2)
			pkg_del luci-app-openlist2 openlist2 luci-i18n-openlist2-zh-cn
			killall -9 openlist2 >/dev/null 2>&1
			clear_native_dir /etc/openlist2
			;;
		feeds)
			pkg_del openlist
			killall -9 openlist >/dev/null 2>&1
			clear_native_dir /etc/openlist
			;;
		esac
		docker rmi "$(ol_image)" >/dev/null 2>&1
		;;
	*)
		echo "用法：hub-ctl remove qbittorrent|openlist" >&2
		return 1
		;;
	esac
	echo "已卸载 $svc（数据目录保留：$(svc_datadir "$svc")）"
}

cmd_logs() {
	local svc="$1" n="${2:-40}"
	case "$svc" in
	qbittorrent)
		if ct_present "$QBT_CT"; then
			docker logs --tail "$n" "$QBT_CT" 2>&1
		else
			tail -n "$n" /var/log/qbittorrent 2>/dev/null ||
				logread 2>/dev/null | grep -i qbittorrent | tail -n "$n"
		fi
		;;
	openlist)
		if ct_present "$OL_CT"; then
			docker logs --tail "$n" "$OL_CT" 2>&1
		else
			logread 2>/dev/null | grep -i openlist | tail -n "$n"
		fi
		;;
	*)
		echo "用法：hub-ctl logs qbittorrent|openlist [行数]" >&2
		return 1
		;;
	esac
}

cmd_task() {
	echo "phase=$(task_phase)"
	echo "log=$TASK_DIR/log"
}

# 后台 worker 入口：任务系统靠 $SELF 重新调起自己，参数前缀下划线区分
case "$1" in
_worker_qb_install)
	qb_worker_install
	exit $?
	;;
_worker_ol_install)
	ol_worker_install
	exit $?
	;;
esac

case "$1" in
status) shift; cmd_status ;;
networks) cmd_networks ;;
setport) shift; cmd_setport "$@" ;;
install) shift; cmd_install "$@" ;;
start | stop | restart) cmd_lifecycle "$2" "$1" ;;
remove) shift; cmd_remove "$@" ;;
logs) shift; cmd_logs "$@" ;;
passwd)
	shift
	case "$1" in
	qbittorrent) shift; qb_set_password "$@" ;;
	openlist) shift; ol_set_password "$@" ;;
	*)
		echo "用法：hub-ctl passwd qbittorrent|openlist <新密码>" >&2
		exit 1
		;;
	esac
	;;
task) cmd_task ;;
*)
	cat >&2 <<EOF
用法：hub-ctl <命令>

  status                          输出所有服务的状态（key=value）
  networks                        可用的 docker 桥接网络
  install <qbittorrent|openlist> [变体]  按指定（或当前）变体安装（后台任务）
  start|stop|restart <svc>        启停
  setport <WebUI端口> [BT端口]     把端口存成设置值（写 UCI + qBittorrent.conf）
  remove <svc>                    卸载（保留数据目录）
  logs <svc> [行数]               日志
  passwd <svc> <新密码>           设置 WebUI / 管理员密码
  task                            任务阶段与日志路径
EOF
	exit 1
	;;
esac
